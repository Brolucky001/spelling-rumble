rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdministrator() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrator";
    }

    match /users/{userId} {
      allow create: if ownsUser(userId) && request.resource.data.role == "student";
      allow read: if ownsUser(userId) || isAdministrator();
      allow update: if isAdministrator() || (ownsUser(userId) && request.resource.data.role == resource.data.role && request.resource.data.email == resource.data.email);
      allow delete: if isAdministrator();

      match /practiceResults/{resultId} {
        allow create: if ownsUser(userId) && request.resource.data.userId == userId;
        allow read: if ownsUser(userId) || isAdministrator();
        allow update, delete: if false;
      }
    }
  }
}
