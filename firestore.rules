rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdministrator() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrator";
    }

    match /users/{userId} {
      allow create: if ownsUser(userId) && (request.resource.data.role == "student" || request.resource.data.role == "teacher" || request.resource.data.role == "school");
      allow read: if ownsUser(userId) || isAdministrator();
      allow update: if isAdministrator() || (ownsUser(userId) && request.resource.data.role == resource.data.role && request.resource.data.email == resource.data.email);
      allow delete: if isAdministrator();

      match /practiceResults/{resultId} {
        allow create: if ownsUser(userId) && request.resource.data.userId == userId;
        allow read: if ownsUser(userId) || isAdministrator();
        allow update, delete: if false;
      }
    }

    match /schools/{schoolId} {
      allow create: if ownsUser(schoolId) && request.resource.data.ownerId == schoolId && request.resource.data.status == "pending";
      allow read: if signedIn();
      allow update: if isAdministrator() || (ownsUser(schoolId) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.status == resource.data.status);
      allow delete: if isAdministrator();
    }

    match /competitions/{competitionId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }

    match /leaderboards/{competitionId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }

    match /notifications/{notificationId} { allow read, write: if false; }
    match /certificates/{certificateId} { allow read, write: if false; }
  }
}
